{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipebox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "./web/dist", "binding": "ASSETS", "run_worker_first": ["/api/*"], "not_found_handling": "single-page-application" },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "recipebox", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "vars": { "CLAUDE_MODEL": "claude-opus-5" }
}
